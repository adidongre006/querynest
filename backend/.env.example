# ---- required (the server refuses to start without them) ----
GROQ_API_KEY=
NIMBLE_API_KEY=
OPEN_WEATHER=

# ---- optional ----
ENV=development                       # "production" disables /docs and /openapi.json
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # CORS + Origin check (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1     # accepted Host headers (wildcards like *.onrender.com work)
TRUST_PROXY=false                     # true ONLY behind a proxy that overwrites X-Forwarded-For
RATE_LIMIT_PER_MINUTE=10              # per IP
RATE_LIMIT_PER_DAY=100                # per IP
GLOBAL_LIMIT_PER_MINUTE=120           # all visitors combined (cost safety net)
MAX_CONCURRENT_RUNS=8                 # simultaneous agent runs before answering 503
RUN_TIMEOUT_SECONDS=60                # hard cap for one answer
MAX_OUTPUT_TOKENS=2048                # includes the model's reasoning tokens
AGENT_RECURSION_LIMIT=10              # caps tool-call loops
NIMBLE_DEEP_SEARCH=false              # true = slower, deeper (raise the two timeouts too)
SEARCH_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
